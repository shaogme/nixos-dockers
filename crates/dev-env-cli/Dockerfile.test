FROM rust:1.85-bookworm

ENV DEV_ENV_HOST_LEAK=ambient-from-docker

WORKDIR /workspace/nixos-dockers
COPY . .

RUN cargo build --locked -p dev-env-provider --bin dev-env-provider-worker
RUN cargo test --locked -p dev-env-cli --test docker --no-run
RUN cargo test --locked -p dev-env-cli --test backend_startup --no-run
CMD ["sh", "-c", "cargo test --locked -p dev-env-cli --test docker -- --nocapture && cargo test --locked -p dev-env-cli --test backend_startup -- --nocapture"]
