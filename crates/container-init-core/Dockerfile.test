FROM docker.io/library/rust:1.88.0-bookworm

WORKDIR /workspace/nixos-dockers
COPY . .

RUN apt-get update \
    && apt-get install --yes --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN cargo test --locked -p container-init-core --features docker-tests --test docker --no-run
CMD ["cargo", "test", "--locked", "-p", "container-init-core", "--features", "docker-tests", "--test", "docker", "--", "--test-threads=1", "--nocapture"]
